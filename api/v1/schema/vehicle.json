{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://evdb.gaiagreen.tech/api/v1/schema/vehicle.json",
  "title": "Electric Vehicle",
  "description": "Schema for electric vehicle data in EVDB",
  "type": "object",
  "required": ["name", "manufacturer", "body", "segment"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Full model name",
      "examples": ["Opel Mokka-e", "Tesla Model 3"]
    },
    "manufacturer": {
      "type": "array",
      "description": "Manufacturer(s) - array to support co-branded vehicles",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "examples": [["Opel"], ["Stellantis", "Peugeot"]]
    },
    "body": {
      "type": "string",
      "description": "Body type",
      "enum": [
        "SEDAN",
        "HATCHBACK",
        "SUV",
        "CROSSOVER",
        "COUPE",
        "CONVERTIBLE",
        "WAGON",
        "VAN",
        "PICKUP",
        "MINIBUS",
        "BUS",
        "TRUCK",
        "OTHER"
      ]
    },
    "segment": {
      "type": "string",
      "description": "Euro car segment (A, B, C, D, E, F, J, M, S)",
      "pattern": "^[ABCDEFMJS][AB]?$",
      "examples": ["JB", "C", "D"]
    },
    "description": {
      "type": "string",
      "description": "Short description of the vehicle (localized)"
    },
    "market_availability": {
      "type": "array",
      "description": "Market availability by country",
      "items": {
        "type": "object",
        "required": ["country", "status"],
        "properties": {
          "country": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 country code",
            "pattern": "^[A-Z]{2}$",
            "examples": ["DE", "PL", "GB", "US"]
          },
          "status": {
            "type": "string",
            "enum": ["available", "discontinued", "announced"],
            "description": "Current availability status"
          },
          "available_since": {
            "type": "string",
            "description": "When the vehicle became/will become available (YYYY-MM)",
            "pattern": "^[0-9]{4}-[0-9]{2}$",
            "examples": ["2021-06", "2024-01"]
          },
          "discontinued_on": {
            "type": "string",
            "description": "When the vehicle was discontinued (YYYY-MM)",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          }
        }
      }
    },
    "battery": {
      "type": "object",
      "description": "Battery specifications",
      "properties": {
        "capacity_kwh": {
          "type": "number",
          "description": "Usable battery capacity in kWh",
          "minimum": 0,
          "examples": [50, 75, 100]
        },
        "gross_capacity_kwh": {
          "type": "number",
          "description": "Gross/total battery capacity in kWh",
          "minimum": 0
        },
        "chemistry": {
          "type": "string",
          "description": "Battery chemistry type",
          "enum": [
            "LFP",
            "NMC",
            "NCA",
            "LTO",
            "SODIUM_ION",
            "SOLID_STATE",
            "OTHER"
          ]
        },
        "chemistry_other": {
          "type": "string",
          "description": "Specify chemistry if 'OTHER' selected"
        },
        "voltage_nominal": {
          "type": "number",
          "description": "Nominal battery voltage in V",
          "minimum": 0
        },
        "warranty_years": {
          "type": "number",
          "description": "Battery warranty period in years",
          "minimum": 0
        },
        "warranty_km": {
          "type": "number",
          "description": "Battery warranty distance in km",
          "minimum": 0
        },
        "warranty_capacity_percent": {
          "type": "number",
          "description": "Guaranteed remaining capacity at warranty end (%)",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "range": {
      "type": "object",
      "description": "Range specifications",
      "properties": {
        "wltp_km": {
          "type": "number",
          "description": "WLTP range in km",
          "minimum": 0
        },
        "epa_km": {
          "type": "number",
          "description": "EPA range in km",
          "minimum": 0
        },
        "nedc_km": {
          "type": "number",
          "description": "NEDC range in km (deprecated)",
          "minimum": 0
        },
        "real_world_km": {
          "type": "number",
          "description": "Estimated real-world range in km",
          "minimum": 0
        }
      }
    },
    "performance": {
      "type": "object",
      "description": "Performance specifications",
      "properties": {
        "power_kw": {
          "type": "number",
          "description": "Total power output in kW",
          "minimum": 0
        },
        "power_hp": {
          "type": "number",
          "description": "Total power output in HP",
          "minimum": 0
        },
        "torque_nm": {
          "type": "number",
          "description": "Total torque in Nm",
          "minimum": 0
        },
        "acceleration_0_100_s": {
          "type": "number",
          "description": "0-100 km/h acceleration in seconds",
          "minimum": 0
        },
        "top_speed_kmh": {
          "type": "number",
          "description": "Top speed in km/h",
          "minimum": 0
        },
        "drivetrain": {
          "type": "string",
          "description": "Drivetrain configuration",
          "enum": ["FWD", "RWD", "AWD", "4WD"]
        },
        "motors": {
          "type": "number",
          "description": "Number of electric motors",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "charging": {
      "type": "object",
      "description": "Charging capabilities",
      "properties": {
        "ac_max_kw": {
          "type": "number",
          "description": "Maximum AC charging power in kW",
          "minimum": 0
        },
        "dc_max_kw": {
          "type": "number",
          "description": "Maximum DC fast charging power in kW",
          "minimum": 0
        },
        "dc_speed_class": {
          "type": "string",
          "description": "DC fast charging speed classification",
          "enum": ["NONE", "SLOW", "MEDIUM", "FAST", "ULTRA_FAST", "HYPER_FAST"]
        },
        "ac_port": {
          "type": "array",
          "description": "AC charging port types",
          "items": {
            "type": "string",
            "enum": ["TYPE1", "TYPE2", "OTHER"]
          }
        },
        "dc_port": {
          "type": "array",
          "description": "DC charging port types",
          "items": {
            "type": "string",
            "enum": ["CCS1", "CCS2", "CHADEMO", "TESLA_NACS", "TESLA_SCC", "GB_T", "OTHER"]
          }
        },
        "charge_time_0_80_min": {
          "type": "number",
          "description": "DC fast charging time 0-80% in minutes",
          "minimum": 0
        },
        "charge_time_0_100_ac_h": {
          "type": "number",
          "description": "AC charging time 0-100% in hours",
          "minimum": 0
        },
        "bidirectional": {
          "type": "boolean",
          "description": "Vehicle-to-grid (V2G) or vehicle-to-home (V2H) capability"
        }
      }
    },
    "dimensions": {
      "type": "object",
      "description": "Physical dimensions",
      "properties": {
        "length_mm": {
          "type": "number",
          "description": "Length in mm",
          "minimum": 0
        },
        "width_mm": {
          "type": "number",
          "description": "Width in mm (excluding mirrors)",
          "minimum": 0
        },
        "height_mm": {
          "type": "number",
          "description": "Height in mm",
          "minimum": 0
        },
        "wheelbase_mm": {
          "type": "number",
          "description": "Wheelbase in mm",
          "minimum": 0
        },
        "weight_kg": {
          "type": "number",
          "description": "Curb weight in kg",
          "minimum": 0
        },
        "cargo_volume_l": {
          "type": "number",
          "description": "Cargo volume in liters",
          "minimum": 0
        },
        "cargo_volume_seats_down_l": {
          "type": "number",
          "description": "Cargo volume with seats folded in liters",
          "minimum": 0
        },
        "frunk_volume_l": {
          "type": "number",
          "description": "Front trunk (frunk) volume in liters",
          "minimum": 0
        },
        "seating_capacity": {
          "type": "number",
          "description": "Number of seats",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "efficiency": {
      "type": "object",
      "description": "Energy efficiency",
      "properties": {
        "consumption_wltp_kwh_100km": {
          "type": "number",
          "description": "WLTP consumption in kWh/100km",
          "minimum": 0
        },
        "consumption_epa_kwh_100km": {
          "type": "number",
          "description": "EPA consumption in kWh/100km",
          "minimum": 0
        }
      }
    },
    "pricing": {
      "type": "object",
      "description": "Pricing information by market",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "msrp": {
            "type": "number",
            "description": "Manufacturer's Suggested Retail Price",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code",
            "pattern": "^[A-Z]{3}$",
            "examples": ["EUR", "USD", "GBP", "PLN"]
          },
          "incentives_max": {
            "type": "number",
            "description": "Maximum available government incentives",
            "minimum": 0
          },
          "year": {
            "type": "number",
            "description": "Model year for this pricing",
            "minimum": 2010,
            "maximum": 2050
          }
        }
      },
      "examples": [
        {
          "DE": {
            "msrp": 35000,
            "currency": "EUR",
            "incentives_max": 6000,
            "year": 2024
          },
          "PL": {
            "msrp": 160000,
            "currency": "PLN",
            "incentives_max": 18750,
            "year": 2024
          }
        }
      ]
    },
    "images": {
      "type": "array",
      "description": "Vehicle images and illustrations",
      "items": {
        "type": "object",
        "required": ["type", "url", "alt"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["exterior", "interior", "technical", "press", "render", "user"],
            "description": "Image category"
          },
          "subtype": {
            "type": "string",
            "description": "Specific view or detail",
            "examples": ["front", "rear", "side", "three-quarter", "dashboard", "seats", "battery", "cutaway"]
          },
          "url": {
            "type": "string",
            "description": "Image URL (relative or absolute)",
            "format": "uri-reference"
          },
          "alt": {
            "type": "string",
            "description": "Alternative text for accessibility"
          },
          "credit": {
            "type": "string",
            "description": "Photo credit / photographer"
          },
          "license": {
            "type": "string",
            "description": "Image license",
            "examples": ["CC BY-SA 4.0", "CC BY 4.0", "Public Domain", "Press Photo"]
          },
          "source_url": {
            "type": "string",
            "description": "Original source URL",
            "format": "uri"
          }
        }
      }
    },
    "production": {
      "type": "object",
      "description": "Production information",
      "properties": {
        "start_year": {
          "type": "number",
          "description": "Production start year",
          "minimum": 1996,
          "maximum": 2050
        },
        "end_year": {
          "type": "number",
          "description": "Production end year (if discontinued)",
          "minimum": 1996,
          "maximum": 2050
        },
        "platform": {
          "type": "string",
          "description": "Vehicle platform/architecture",
          "examples": ["MEB", "STLA Medium", "Ultium", "e-GMP"]
        },
        "assembly_location": {
          "type": "array",
          "description": "Assembly plant locations",
          "items": {
            "type": "string"
          },
          "examples": [["Zaragoza, Spain"], ["Fremont, California, USA", "Shanghai, China"]]
        }
      }
    },
    "external_ids": {
      "type": "object",
      "description": "External identifiers and links",
      "properties": {
        "vin_prefix": {
          "type": "array",
          "description": "VIN prefix patterns for this model",
          "items": {
            "type": "string"
          }
        },
        "wikipedia": {
          "type": "string",
          "description": "Wikipedia URL",
          "format": "uri"
        },
        "official_url": {
          "type": "string",
          "description": "Official manufacturer product page",
          "format": "uri"
        }
      }
    },
    "last_updated": {
      "type": "string",
      "description": "Last update timestamp (ISO 8601)",
      "format": "date-time"
    }
  }
}
